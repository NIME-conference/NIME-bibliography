  abstract = {Bowl Chant is a composition for four Tibetan Singing Bowls, two small Thai mediation bells, and two ancient Balinese gongs. The work is controlled using four sensors allowing the performers to add or refresh material being explored by the Capybara system; a dialogue between performers and computer is established. The composition explores the interstitial spaces between the ancient and modern, seeking a meeting point where the two worlds support each other in a rich new timbral space.}
}

@inproceedings{nime2006_music_Franco,
  author = {Ximena Franco and Enrique Franco},
  title = {Live Fire},
  pages = {426},
  numpages = {1},
